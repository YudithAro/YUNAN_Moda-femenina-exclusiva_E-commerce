// use prisma-next

enum Role {
  USER
  ADMIN
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(USER)
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
  orders    Order[]
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  products    Product[]
  createdAt   TimestamptzString  @default(now())
  updatedAt   temporal.updatedAtString()
}

model Product {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  description String?
  price       Decimal
  categoryId  String
  category    Category   @relation(fields: [categoryId], references: [id])
  images      String[]
  stock       Int        @default(0)
  variants    Variant[]
  orderItems  OrderItem[]
  createdAt   TimestamptzString   @default(now())
  updatedAt   temporal.updatedAtString()
}

model Variant {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  size      String?
  color     String?
  stock     Int      @default(0)
}

model Order {
  id            String      @id @default(uuid())
  userId        String?
  user          User?       @relation(fields: [userId], references: [id])
  customerName  String?
  customerPhone String?
  total      Decimal
  status     String      @default("PENDING") // PENDING, PAID, SHIPPED, DELIVERED, CANCELLED
  items      OrderItem[]
  createdAt  TimestamptzString    @default(now())
  updatedAt  temporal.updatedAtString()
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  price     Decimal
}
