NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_SUPABASE_POOLER:5432/postgres
DATABASE_POOL_MAX=5
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Optional Supabase CA certificate; literal \n is supported.
# DATABASE_SSL_CA=
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
# Optional: use the publishable/anon key for getUser token validation.
# SUPABASE_ANON_KEY=
CORS_ORIGINS=http://localhost:4000
